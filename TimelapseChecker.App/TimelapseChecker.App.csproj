<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <AssemblyName>TimelapseChecker</AssemblyName>
    <RootNamespace>TimelapseChecker.App</RootNamespace>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TimelapseChecker.Core\TimelapseChecker.Core.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <!-- 指標の推移グラフ（SwitchBotMeterと同じ） -->
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
  </ItemGroup>

  <!-- ビルドのたびにリビジョン(4桁目)を1つ増やす。Major.Minor.Buildはここを直接編集して手動管理する。
       WPFのXAMLコンパイル用一時プロジェクト(*_wpftmp.csproj)でも走り二重加算されるため、本体のみ実行する。 -->
  <PropertyGroup>
    <VersionMajorMinorBuild>1.0.0</VersionMajorMinorBuild>
    <RevisionFile>$(MSBuildProjectDirectory)\revision.txt</RevisionFile>
  </PropertyGroup>

  <Target Name="IncrementRevision" BeforeTargets="BeforeBuild" Condition="!$(MSBuildProjectName.EndsWith('_wpftmp'))">
    <ReadLinesFromFile File="$(RevisionFile)" Condition="Exists('$(RevisionFile)')">
      <Output TaskParameter="Lines" ItemName="RevisionLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <CurrentRevision Condition="'@(RevisionLines)' != ''">@(RevisionLines)</CurrentRevision>
      <CurrentRevision Condition="'$(CurrentRevision)' == ''">0</CurrentRevision>
      <NewRevision>$([MSBuild]::Add($(CurrentRevision), 1))</NewRevision>
    </PropertyGroup>
    <WriteLinesToFile File="$(RevisionFile)" Lines="$(NewRevision)" Overwrite="true" />
    <PropertyGroup>
      <AssemblyVersion>$(VersionMajorMinorBuild).$(NewRevision)</AssemblyVersion>
      <FileVersion>$(VersionMajorMinorBuild).$(NewRevision)</FileVersion>
      <InformationalVersion>$(VersionMajorMinorBuild).$(NewRevision)</InformationalVersion>
    </PropertyGroup>
  </Target>

</Project>
